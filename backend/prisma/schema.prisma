generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
}

enum Theme {
  LIGHT
  DARK
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(AGENT)
  theme        Theme     @default(LIGHT)
  active       Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  auditLogs            AuditLog[]
  assignedLeads        Lead[]               @relation("LeadAssignee")
  deletedLeads         Lead[]               @relation("LeadDeletedBy")
  sentMessages         Message[]
  campaigns            Campaign[]
  sales                Sale[]
  leadImports          LeadImport[]
  notifications        Notification[]
  ownedPipelines       Pipeline[]           @relation("PipelineOwner")
  pipelineMemberships  PipelineMember[]     @relation("PipelineMembership")
  addedPipelineMembers PipelineMember[]     @relation("PipelineMemberAddedBy")
  addedPipelineCards   PipelineCard[]
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?  @db.Uuid
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

enum InstanceProvider {
  EVOLUTION
  CLOUD_API
}

enum InstanceStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
}

model WhatsappInstance {
  id            String           @id @default(uuid()) @db.Uuid
  name          String
  provider      InstanceProvider
  status        InstanceStatus   @default(DISCONNECTED)
  phoneNumber   String?
  instanceName  String?          @unique
  phoneNumberId String?          @unique
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  messages  Message[]
  templates MessageTemplate[]
  campaigns Campaign[]
  leads     Lead[]
}

model Pipeline {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  position  Int      @default(0)
  ownerId   String   @db.Uuid
  owner     User     @relation("PipelineOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages      Stage[]
  members     PipelineMember[]
  cards       PipelineCard[]
  campaigns   Campaign[]
  leadImports LeadImport[]

  @@index([ownerId])
}

model PipelineMember {
  id         String   @id @default(uuid()) @db.Uuid
  pipelineId String   @db.Uuid
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  userId     String   @db.Uuid
  user       User     @relation("PipelineMembership", fields: [userId], references: [id], onDelete: Cascade)
  addedById  String   @db.Uuid
  addedBy    User     @relation("PipelineMemberAddedBy", fields: [addedById], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@unique([pipelineId, userId])
  @@index([userId])
}

model PipelineCard {
  id          String    @id @default(uuid()) @db.Uuid
  pipelineId  String    @db.Uuid
  pipeline    Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId     String    @db.Uuid
  stage       Stage     @relation(fields: [stageId], references: [id], onDelete: Restrict)
  leadId      String    @db.Uuid
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  position    Float
  wonValue    Decimal?  @db.Decimal(12, 2)
  closingNote String?
  closedAt    DateTime?
  addedById   String    @db.Uuid
  addedBy     User      @relation(fields: [addedById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([pipelineId, leadId])
  @@index([stageId, position])
  @@index([leadId])
}

model Stage {
  id         String   @id @default(uuid()) @db.Uuid
  pipelineId String   @db.Uuid
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String
  color      String   @default("#64748b")
  position   Int      @default(0)
  isWon      Boolean  @default(false)
  isLost     Boolean  @default(false)
  createdAt  DateTime @default(now())

  cards       PipelineCard[]
  campaigns   Campaign[]
  leadImports LeadImport[]

  @@index([pipelineId])
}

enum LeadContactStatus {
  VALID
  INVALID
  SPAM
}

model Lead {
  id            String                   @id @default(uuid()) @db.Uuid
  name          String
  phone         String?                  @unique
  phoneCountry  String?
  email         String?                  @unique
  source        String?
  tags          String[]                 @default([])
  value         Decimal?                 @db.Decimal(12, 2)
  contactStatus LeadContactStatus        @default(VALID)
  enteredOn     DateTime                 @db.Date
  assignedToId  String?                  @db.Uuid
  assignedTo    User?                    @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  instanceId    String?                  @db.Uuid
  instance      WhatsappInstance?        @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  unreadCount   Int                      @default(0)
  lastMessageAt DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  deletedAt     DateTime?
  deletedById   String?                  @db.Uuid
  deletedBy     User?                    @relation("LeadDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  searchVector  Unsupported("tsvector")? @default(dbgenerated())

  messages      Message[]
  recipients    CampaignRecipient[]
  sales         Sale[]
  pipelineCards PipelineCard[]

  @@index([lastMessageAt])
  @@index([assignedToId])
  @@index([contactStatus])
  @@index([source])
  @@index([enteredOn])
  @@index([deletedAt, createdAt])
  @@index([searchVector], type: Gin)
}

enum LeadImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

model LeadImport {
  id                     String           @id @default(uuid()) @db.Uuid
  status                 LeadImportStatus @default(PENDING)
  totalRows              Int
  invalidRows            Int
  duplicateRowsInFile    Int
  rowsToImport           Int
  importedLeads          Int              @default(0)
  skippedExistingLeads   Int              @default(0)
  addedToPipelineLeads   Int              @default(0)
  alreadyInPipelineLeads Int              @default(0)
  processedRows          Int              @default(0)
  pipelineId             String?          @db.Uuid
  pipeline               Pipeline?        @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stageId                String?          @db.Uuid
  stage                  Stage?           @relation(fields: [stageId], references: [id], onDelete: SetNull)
  requestedById          String           @db.Uuid
  requestedBy            User             @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  failureReason          String?
  createdAt              DateTime         @default(now())
  startedAt              DateTime?
  finishedAt             DateTime?
  expiryWarningSentAt    DateTime?

  rows LeadImportRow[]

  @@index([status, createdAt])
  @@index([status, finishedAt])
  @@index([requestedById])
}

enum NotificationType {
  LEAD_IMPORT_COMPLETED
  LEAD_IMPORT_FAILED
  LEAD_IMPORT_EXPIRING
  LEAD_IMPORT_EXPIRED
  PIPELINE_MEMBER_ADDED
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  actionUrl String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

model LeadImportRow {
  id           String     @id @default(uuid()) @db.Uuid
  leadImportId String     @db.Uuid
  leadImport   LeadImport @relation(fields: [leadImportId], references: [id], onDelete: Cascade)
  rowNumber    Int
  name         String
  phone        String
  phoneCountry String?
  email        String?
  enteredOn    DateTime   @db.Date

  @@index([leadImportId, rowNumber])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  TEMPLATE
  OTHER
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id         String            @id @default(uuid()) @db.Uuid
  leadId     String            @db.Uuid
  lead       Lead              @relation(fields: [leadId], references: [id], onDelete: Restrict)
  instanceId String?           @db.Uuid
  instance   WhatsappInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  direction  MessageDirection
  type       MessageType       @default(TEXT)
  content    String?
  mediaUrl   String?
  externalId String?           @unique
  status     MessageStatus     @default(PENDING)
  sentById   String?           @db.Uuid
  sentBy     User?             @relation(fields: [sentById], references: [id], onDelete: SetNull)
  campaignId String?           @db.Uuid
  campaign   Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())

  @@index([leadId, createdAt])
}

model MessageTemplate {
  id         String           @id @default(uuid()) @db.Uuid
  instanceId String           @db.Uuid
  instance   WhatsappInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  name       String
  language   String           @default("pt_BR")
  category   String?
  status     String?
  components Json
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  campaigns Campaign[]

  @@unique([instanceId, name, language])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELED
  FAILED
}

model Campaign {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  status          CampaignStatus   @default(DRAFT)
  instanceId      String           @db.Uuid
  instance        WhatsappInstance @relation(fields: [instanceId], references: [id])
  templateId      String           @db.Uuid
  template        MessageTemplate  @relation(fields: [templateId], references: [id])
  pipelineId      String           @db.Uuid
  pipeline        Pipeline         @relation(fields: [pipelineId], references: [id])
  stageId         String?          @db.Uuid
  stage           Stage?           @relation(fields: [stageId], references: [id])
  batchSize       Int              @default(10)
  intervalSeconds Int              @default(60)
  templateParams  Json?
  scheduledAt     DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdById     String?          @db.Uuid
  createdBy       User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  recipients CampaignRecipient[]
  messages   Message[]

  @@index([status, scheduledAt])
}

enum RecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model CampaignRecipient {
  id         String          @id @default(uuid()) @db.Uuid
  campaignId String          @db.Uuid
  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId     String          @db.Uuid
  lead       Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status     RecipientStatus @default(PENDING)
  error      String?
  sentAt     DateTime?

  @@unique([campaignId, leadId])
  @@index([campaignId, status])
}

model Automation {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  active     Boolean  @default(true)
  trigger    String
  conditions Json?
  actions    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Sale {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String?  @db.Uuid
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Restrict)
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount    Decimal  @db.Decimal(12, 2)
  product   String?
  closedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([closedAt])
}

model TrafficMetric {
  id          String   @id @default(uuid()) @db.Uuid
  date        DateTime @db.Date
  source      String
  campaign    String?
  impressions Int      @default(0)
  clicks      Int      @default(0)
  leads       Int      @default(0)
  spend       Decimal  @default(0) @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  @@unique([date, source, campaign])
  @@index([date])
}
